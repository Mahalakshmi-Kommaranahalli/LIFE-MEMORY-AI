# Life Memory AI - Environment Configuration

# Application
APP_NAME="Life Memory AI"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"
SECRET_KEY="change-this-in-production-use-a-strong-random-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with pgvector or SQLite fallback)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/lifememory"
# For SQLite development fallback:
# DATABASE_URL="sqlite+aiosqlite:///./lifememory.db"

# AI Provider Configuration (Configurable: OpenAI, Gemini, Anthropic, or Mock)
AI_PROVIDER="mock"  # options: "openai", "gemini", "mock"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# Memory Engine Settings
MEMORY_AUTO_EXTRACT=true
MEMORY_CONFIDENCE_THRESHOLD=0.75
MAX_RELEVANT_MEMORIES_RETRIEVED=5
ENABLE_CONFLICT_DETECTION=true

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

